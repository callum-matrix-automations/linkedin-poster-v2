{
  "name": "linkedin-poster-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names next,proxy --prefix-colors blue,yellow \"next dev\" \"node proxy/server.js\"",
    "dev:next": "next dev",
    "dev:proxy": "node proxy/server.js",
    "build": "next build",
    "start": "node proxy/seed-token.mjs && concurrently --kill-others-on-fail --names next,proxy --prefix-colors blue,yellow \"next start\" \"node proxy/server.js\"",
    "start:next": "next start",
    "start:proxy": "node proxy/server.js",
    "lint": "eslint"
  },
  "dependencies": {
    "concurrently": "^10.0.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
