// Prisma 7 schema. Connection config lives in prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth v5) models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts Account[]
  sessions Session[]
  profile  Profile?
  drafts   Draft[]

  @@map("users")
}

// --- App data (per user) ---

model Profile {
  id                 String  @id @default(cuid())
  userId             String  @unique @map("user_id")
  name               String  @default("")
  title              String  @default("")
  industry           String  @default("")
  targetAudience     String  @default("") @map("target_audience")
  uniqueBackground   String  @default("") @map("unique_background")
  contrarian         String  @default("")
  personalStory      String  @default("") @map("personal_story")
  expertise          String  @default("")
  tone               String  @default("")
  completedOnboarding Boolean @default(false) @map("completed_onboarding")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Draft {
  id      String @id @default(cuid())
  userId  String @map("user_id")
  content String @default("")
  status  String @default("drafting") // "drafting" | "finished"

  // The PostSuggestion that seeded this draft (title, hook, angle, type).
  suggestion Json
  // The LinkedInPost[] used as inspiration for this draft.
  inspirationPosts Json @map("inspiration_posts")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("posts")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
