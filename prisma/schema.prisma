// Prisma 7 schema. Connection config lives in prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth v5) models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts Account[]
  sessions Session[]
  profile  Profile?
  drafts   Draft[]
  providerSettings ProviderSettings?
  linkedinConnection LinkedInConnection?

  @@map("users")
}

// --- App data (per user) ---

model Profile {
  id                 String  @id @default(cuid())
  userId             String  @unique @map("user_id")
  name               String  @default("")
  title              String  @default("")
  industry           String  @default("")
  targetAudience     String  @default("") @map("target_audience")
  uniqueBackground   String  @default("") @map("unique_background")
  contrarian         String  @default("")
  personalStory      String  @default("") @map("personal_story")
  expertise          String  @default("")
  tone               String  @default("")
  completedOnboarding Boolean @default(false) @map("completed_onboarding")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// --- BYOK provider settings (per user) ---
//
// Each *Key column stores an AES-256-GCM ciphertext (see src/lib/crypto.ts),
// never a plaintext key. The *Model columns store the user's chosen model id
// for that provider. activeProvider names which provider generation uses.
model ProviderSettings {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  // Which provider generation uses: "openai" | "anthropic" | "gemini".
  // Empty string = not configured yet.
  activeProvider String @default("") @map("active_provider")

  // Encrypted keys (ciphertext or null when unset).
  openaiKey    String? @map("openai_key")
  anthropicKey String? @map("anthropic_key")
  geminiKey    String? @map("gemini_key")

  // Selected model per provider.
  openaiModel    String @default("gpt-5.4-mini") @map("openai_model")
  anthropicModel String @default("claude-sonnet-4-6") @map("anthropic_model")
  geminiModel    String @default("gemini-2.5-flash") @map("gemini_model")

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("provider_settings")
}

// --- LinkedIn connection (per user, for posting on their behalf) ---
//
// A standalone OAuth link, separate from app login. accessToken is an
// AES-256-GCM ciphertext (see src/lib/crypto.ts), never plaintext.
// linkedinSub is the OIDC "sub" used to build the author URN
// (urn:li:person:{sub}). refreshToken is usually null — LinkedIn only issues
// refresh tokens to approved Marketing partners, so we expect ~60-day
// reconnects rather than silent refresh.
model LinkedInConnection {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  linkedinSub  String   @map("linkedin_sub")
  name         String   @default("")
  accessToken  String   @map("access_token")
  refreshToken String?  @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  scope        String   @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("linkedin_connections")
}

model Draft {
  id      String @id @default(cuid())
  userId  String @map("user_id")
  content String @default("")
  status  String @default("drafting") // "drafting" | "finished"

  // The PostSuggestion that seeded this draft (title, hook, angle, type).
  suggestion Json
  // The LinkedInPost[] used as inspiration for this draft.
  inspirationPosts Json @map("inspiration_posts")

  // Optional generated image attached to the post. imageData is a base64 PNG
  // (no data: prefix); imageMime is its mime type; imageAlt is LinkedIn alt text.
  imageData String? @map("image_data")
  imageMime String? @map("image_mime")
  imageAlt  String? @map("image_alt")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("posts")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
