{
  "name": "elevateo-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Elevateo Posts desktop shell — opens the hosted app and runs the local Claude proxy.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "co.elevateo.posts",
    "productName": "Elevateo Posts",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../proxy",
        "to": "proxy",
        "filter": ["**/*", "!tokens.json", "!**/node_modules/**"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png",
      "artifactName": "Elevateo-Posts-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "icon.png",
      "artifactName": "Elevateo-Posts.${ext}",
      "identity": null
    }
  }
}
